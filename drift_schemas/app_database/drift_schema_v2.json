  "fixed_sql": [
    {
      "name": "areas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"areas\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon_name\" TEXT NOT NULL DEFAULT 'general', \"display_order\" INTEGER NOT NULL DEFAULT 0 CHECK(\"display_order\" >= 0), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"area_id\" INTEGER NOT NULL REFERENCES areas (id) ON UPDATE CASCADE ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"behavior_profile\" TEXT NOT NULL CHECK(\"behavior_profile\" IN ('replenishable', 'countableReplenishable', 'durable')), \"stock_status\" TEXT NOT NULL CHECK(\"stock_status\" IN ('inStock', 'outOfStock')), \"unit\" TEXT NULL, \"package_count\" INTEGER NULL CHECK(\"package_count\" IS NULL OR \"package_count\" >= 0), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (package_count IS NULL OR (package_count > 0 AND stock_status = 'inStock') OR (package_count = 0 AND stock_status = 'outOfStock')), CHECK (behavior_profile != 'durable' OR package_count IS NULL));"
        }
      ]
    },
    {
      "name": "lifecycle_cycles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lifecycle_cycles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"item_id\" INTEGER NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"started_on\" TEXT NOT NULL, \"finished_on\" TEXT NULL, CHECK (length(started_on) = 10 AND started_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND started_on BETWEEN '1900-01-01' AND '2200-12-31' AND date(started_on, '+0 days') IS started_on), CHECK (finished_on IS NULL OR (length(finished_on) = 10 AND finished_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND finished_on BETWEEN '1900-01-01' AND '2200-12-31' AND date(finished_on, '+0 days') IS finished_on)), CHECK (finished_on IS NULL OR finished_on >= started_on));"
        }
      ]
    },
    {
      "name": "lifecycle_checkpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lifecycle_checkpoints\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"cycle_id\" INTEGER NOT NULL REFERENCES lifecycle_cycles (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('aboutHalf', 'nearlyFinished')), \"observed_on\" TEXT NOT NULL, CHECK (length(observed_on) = 10 AND observed_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND observed_on BETWEEN '1900-01-01' AND '2200-12-31' AND date(observed_on, '+0 days') IS observed_on));"
        }
      ]
    },
